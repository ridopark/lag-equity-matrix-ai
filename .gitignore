# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local env. .env.example is the committed template; every other variant is local.
.env*
!.env.example
.pytest_cache/
.ruff_cache/
.mypy_cache/

# experiment data (not committed) -- data/* not data/, so the negation below
# is consulted; git never descends into an excluded *directory*.
data/*
# ...except the exclusion list runner.py loads at startup: a point-in-time
# Alpaca snapshot of leveraged/inverse product *names*, carrying no signal or
# price content, which re-running build_exclusions.py does not reproduce.
!data/excluded-etfs.csv

# Baseline inputs and their fixture projections stay local. They carry either
# vendor price data or the tickers and dates the signal feed actually fired on.
# scripts/build_fixture.py regenerates the fixtures from data/.
tests/fixtures/

# Data by kind, not only by location. Everything above is path-based, so a bar
# pull, an extract or a checkpoint written anywhere else would not be caught.
# Nothing of these types is meant to be tracked; add an explicit negation if
# that ever changes, rather than loosening these.
*.parquet
*.sqlite
*.sqlite3

# unlazy local coordination state (per-machine, not shared)
.claude/settings.local.json
.unlazy/
.unlazy-hook-state.json

# langgraph checkpoints (local run state)
data/checkpoints.sqlite
